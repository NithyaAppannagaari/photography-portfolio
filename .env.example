# Password for the album desk at /share/admin.
# Copy this file to .env for local Vite (`npm run dev`).
# Generate a password with: openssl rand -base64 24
# Do not prefix this with VITE_. It must stay off the public site.
SHARE_ADMIN_PASSWORD=

# Contact form. The server reads these. Do not prefix them with VITE_.
# Set the same names in Vercel: Project Settings, Environment Variables.
# RESEND_API_KEY is the Resend API key.
# CONTACT_TO_EMAIL is where inquiries should be delivered.
# CONTACT_FROM_EMAIL is the sender. Leave the onboarding address until a domain is verified.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
